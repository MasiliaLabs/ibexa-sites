{# The sites page is a React application: it loads its data from the JSON API, and gets the configuration of the content browser here. #}
{% extends '@ibexadesign/masilia_kit/page.html.twig' %}

{% trans_default_domain 'masilia_ibexa_sites' %}

{% set kit_title = 'sites.title'|trans %}
{% set kit_entry = 'masilia-sites-react' %}
{% set kit_body_class = 'masilia-sites-view' %}
{% set kit_root = {
    id: 'masilia-sites-root',
    data: {
        api: path('masilia.ibexa_sites.api.data'),
        'udw-root': ibexa_udw_config('masilia_site_root', {}),
        'udw-layout': ibexa_udw_config('masilia_site_layout', {}),
    },
} %}
