{% extends "@ibexadesign/ui/layout.html.twig" %}

{% trans_default_domain 'masilia_ibexa_sites' %}
{% form_theme form '@ibexadesign/ui/form_fields.html.twig' %}

{% set heading = site is null ? 'sites.new'|trans : 'sites.edit'|trans({ '%name%': site.name }) %}

{% macro row(entry) %}
    <div class="card ibexa-card ibexa-card--light masilia-siteaccess" style="margin-bottom:1rem">
        <div class="card-body ibexa-card__body ibexa-form-block">
            {{ form_row(entry.name, { row_attr: { class: 'ibexa-form-field' } }) }}
            {{ form_row(entry.language, { row_attr: { class: 'ibexa-form-field' } }) }}
            {{ form_row(entry.fallbacks, { row_attr: { class: 'ibexa-form-field' } }) }}
            {{ form_row(entry.host, { row_attr: { class: 'ibexa-form-field' } }) }}
            {{ form_row(entry.uriPrefix, { row_attr: { class: 'ibexa-form-field' } }) }}
            <button type="button" class="btn ibexa-btn ibexa-btn--secondary masilia-remove-siteaccess">{{ 'form.siteaccess.remove'|trans }}</button>
        </div>
    </div>
{% endmacro %}

{% block body_class %}masilia-sites-view{% endblock %}

{% block breadcrumbs %}
    {% include '@ibexadesign/ui/breadcrumbs.html.twig' with { items: [
        { value: 'breadcrumb.admin'|trans },
        { value: 'sites.title'|trans, url: path('masilia.ibexa_sites.list') },
        { value: heading }
    ]} %}
{% endblock %}

{% block title %}{{ heading }}{% endblock %}

{% block header %}
    {% include '@ibexadesign/ui/page_title.html.twig' with { title: heading } %}
{% endblock %}

{% block content %}
    <div class="masilia-sites">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="card ibexa-card ibexa-card--light">
                <div class="card-body ibexa-card__body ibexa-form-block">
                    {% for name in ['identifier', 'name', 'rootLocationId', 'design', 'base', 'layoutRemoteId', 'varDir', 'sessionCookieDomain', 'adminSiteaccess'] %}
                        {{ form_row(attribute(form, name), { row_attr: { class: 'ibexa-form-field' } }) }}
                    {% endfor %}
                </div>
            </div>
            {% for list in ['siteaccesses', 'adminSiteaccesses'] %}
                {% set collection = attribute(form, list) %}
                <h2 class="ibexa-header__name">{{ ('form.' ~ (list == 'siteaccesses' ? 'siteaccesses' : 'admin_siteaccesses'))|trans }}</h2>
                {% if list == 'adminSiteaccesses' %}<p class="ibexa-text-muted">{{ 'form.admin_siteaccesses.help'|trans }}</p>{% endif %}
                <div class="masilia-siteaccess-list" id="masilia-{{ list }}" data-prototype="{{ _self.row(collection.vars.prototype)|e('html_attr') }}" data-index="{{ collection|length }}">
                    {% for entry in collection %}
                        {{ _self.row(entry) }}
                    {% endfor %}
                </div>
                <p><button type="button" class="btn ibexa-btn ibexa-btn--secondary masilia-add-siteaccess" data-target="masilia-{{ list }}">{{ 'form.siteaccess.add'|trans }}</button></p>
                {% do collection.setRendered %}
            {% endfor %}
            <p>
                <button class="btn ibexa-btn ibexa-btn--primary" type="submit">{{ 'action.save'|trans }}</button>
                <a class="btn ibexa-btn ibexa-btn--secondary" href="{{ path('masilia.ibexa_sites.list') }}">{{ 'action.cancel'|trans }}</a>
            </p>
        {{ form_end(form) }}
        {% if site is not null and site.status.value == 'active' %}
            <div class="ibexa-alert ibexa-alert--info" role="note"><p>{{ 'form.active.note'|trans }}</p></div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            document.querySelectorAll('.masilia-add-siteaccess').forEach(function (button) {
                button.addEventListener('click', function () {
                    var list = document.getElementById(button.dataset.target);
                    var index = parseInt(list.dataset.index, 10);
                    list.dataset.index = index + 1;
                    list.insertAdjacentHTML('beforeend', list.dataset.prototype.replace(/__name__/g, index));
                });
            });
            document.querySelectorAll('.masilia-siteaccess-list').forEach(function (list) {
                list.addEventListener('click', function (event) {
                    var button = event.target.closest('.masilia-remove-siteaccess');
                    if (button) { button.closest('.masilia-siteaccess').remove(); }
                });
            });
        })();
    </script>
{% endblock %}
