{
    "name": "masilia/ibexa-sites",
    "description": "Sites created at run time: a registry of sites (hosts, languages, root, design) that Ibexa serves without a deploy",
    "keywords": [
        "ibexa",
        "ibexa-dxp",
        "ibexa-5",
        "symfony-bundle",
        "multisite",
        "siteaccess",
        "sites",
        "admin-ui"
    ],
    "homepage": "https://github.com/MasiliaLabs/ibexa-sites",
    "license": "MIT",
    "authors": [
        {
            "name": "MasiliaLabs",
            "homepage": "https://github.com/MasiliaLabs"
        }
    ],
    "support": {
        "issues": "https://github.com/MasiliaLabs/ibexa-sites/issues",
        "source": "https://github.com/MasiliaLabs/ibexa-sites",
        "security": "https://github.com/MasiliaLabs/ibexa-sites/security/policy"
    },
    "type": "ibexa-bundle",
    "require": {
        "php": ">=8.3",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^2.20 || ^3.0",
        "ibexa/admin-ui": "^5.0",
        "ibexa/core": "^5.0",
        "masilia/ibexa-admin-kit": "^0.1.1",
        "psr/cache": "^3.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/security-csrf": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "symfony/cache": "^7.4",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Masilia\\Bundle\\IbexaSites\\": "src/bundle/",
            "Masilia\\Contracts\\IbexaSites\\": "src/contracts/",
            "Masilia\\IbexaSites\\": "src/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masilia\\IbexaSites\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpunit": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": [
            "@phpunit",
            "@phpstan"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:MasiliaLabs/ibexa-admin-kit.git"
        }
    ],
    "suggest": {
        "masilia/editorial-toolbox": "Gives the in-context editing toolbox the admin siteaccess of each site",
        "masilia/ibexa-ai-craft": "The assistant creates and changes sites (site.* capabilities)",
        "masilia/ibexa-blocks": "Gives each site its layout (masilia_ibexa_blocks.layout_remote_id) from the registry"
    }
}
